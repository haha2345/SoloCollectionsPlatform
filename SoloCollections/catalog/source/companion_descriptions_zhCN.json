{
  "entries": [
    {
      "collectionId": 100309,
      "creatureEntry": 2671,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "机械松鼠体内的逻辑运算中心告诉它，要多多采集坚果和螺栓，以备冬季取用。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 39,
      "spellId": 4055
    },
    {
      "collectionId": 100310,
      "creatureEntry": 7380,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "它漂亮的蓝眼睛闻名遐迩，同时也被大鱼人视为美味佳肴。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 44,
      "spellId": 10677
    },
    {
      "collectionId": 100311,
      "creatureEntry": 7381,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "睡懒觉是这只猫的第二大嗜好。第一大嗜好是打哈欠。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 45,
      "spellId": 10678
    },
    {
      "collectionId": 100312,
      "creatureEntry": 7382,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "上一个想要驯服这只猫的家伙很快意识到，地毯上有点污渍，总比整张地毯被撕成碎片来的强。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 43,
      "spellId": 10676
    },
    {
      "collectionId": 100313,
      "creatureEntry": 7383,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "老奥特兰克俗语说：‘猫有九命，但却只需要其中之一。’",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 42,
      "spellId": 10675
    },
    {
      "collectionId": 100314,
      "creatureEntry": 7384,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "冬妮·安萨妮娅邀请这些猫来她的午后茶会，但她没有提供它们最爱的饮品：敌人的眼泪。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 41,
      "spellId": 10674
    },
    {
      "collectionId": 100315,
      "creatureEntry": 7385,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "冬妮·安萨妮娅计划在她临终时找一只灰猫陪葬，聪明的冒险者此刻又能大展身手了。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 40,
      "spellId": 10673
    },
    {
      "collectionId": 100316,
      "creatureEntry": 7386,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "‘皇后有三只猫。第一只猫给她抓来了肥硕的老鼠；第二只猫给她弄来了美味的野兔；而最后那只她最爱的白猫，给她送上了仇敌的头颅。’",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 46,
      "spellId": 10679
    },
    {
      "collectionId": 100317,
      "creatureEntry": 7387,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "这种五彩缤纷的小鸟是迪菲亚海盗喜爱的宠物，擅长记忆口令，购物清单和爆竹配方。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 50,
      "spellId": 10683
    },
    {
      "collectionId": 100319,
      "creatureEntry": 7389,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "深受藏宝海湾地精们所喜爱的一个宠物，这只色彩艳丽的小鸟不仅会数钱，还会讨价还价，而且撒谎从不脸红。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 51,
      "spellId": 10684
    },
    {
      "collectionId": 100320,
      "creatureEntry": 7390,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "有人说这只聪明的鸟能学会说话——但它很机灵，知道什么叫沉默是金。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 47,
      "spellId": 10680
    },
    {
      "collectionId": 100291,
      "creatureEntry": 7391,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "丛林巨魔训练这些鸟儿模仿呼救声，引诱那些无知的旅行者并将他们引入陷阱。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 49,
      "spellId": 10682
    },
    {
      "collectionId": 100323,
      "creatureEntry": 7394,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "在它看来，你吃上去也像鸡肉。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 52,
      "spellId": 10685
    },
    {
      "collectionId": 100324,
      "creatureEntry": 7395,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "这只蟑螂通常是冲动消费的产物。购买者总是使劲浑身解数也难以摆脱它。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 55,
      "spellId": 10688
    },
    {
      "collectionId": 100325,
      "creatureEntry": 7543,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "但愿有一天，它能长成像它母亲那样能够攻城拔寨的巨龙。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 56,
      "spellId": 10695
    },
    {
      "collectionId": 100326,
      "creatureEntry": 7544,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "这头小龙来自湿地，还在学习捕猎、喷火并不断可爱地发着毁灭性脾气。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 58,
      "spellId": 10697
    },
    {
      "collectionId": 100283,
      "creatureEntry": 7545,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "这种独特的雏龙曾由绿龙伊萨里奥斯孵化并抚育，已经在菲拉斯的丛林中安居了下来。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 59,
      "spellId": 10698
    },
    {
      "collectionId": 100327,
      "creatureEntry": 7546,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "青铜龙宝宝在时间中迷失了，直到发生了一次不同寻常的事件，她才得以逃脱。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 1563,
      "spellId": 10699
    },
    {
      "collectionId": 100328,
      "creatureEntry": 7547,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "和蓝龙军团的其他成员一样，这些古怪的小龙展现出了对奥术魔法的非凡亲和力。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 57,
      "spellId": 10696
    },
    {
      "collectionId": 100330,
      "creatureEntry": 7549,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "它们以强劲的腿脚和敏锐的视力著称于世。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 65,
      "spellId": 10704
    },
    {
      "collectionId": 100331,
      "creatureEntry": 7550,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "暗月马戏团的商贩经常卖一些稀奇古怪的东西，林蛙就是其中之一。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 64,
      "spellId": 10703
    },
    {
      "collectionId": 100334,
      "creatureEntry": 7553,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "暗夜精灵的孩子在他们第一次生日时都会得到一根猫头鹰的羽毛，它象征着好运常伴。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 68,
      "spellId": 10707
    },
    {
      "collectionId": 100335,
      "creatureEntry": 7554,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "冬泉谷的熊怪很珍视这些美丽生物的雪白羽毛，并将其用于举行仪式。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 69,
      "spellId": 10708
    },
    {
      "collectionId": 100336,
      "creatureEntry": 7555,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "在泰达希尔的德鲁伊中，这种黑色羽毛的猛禽经常被视为是末日来临的先兆。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 67,
      "spellId": 10706
    },
    {
      "collectionId": 100340,
      "creatureEntry": 7560,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "要是你一直追逐雪兔，那你就离摔跟头不远了。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 72,
      "spellId": 10711
    },
    {
      "collectionId": 100341,
      "creatureEntry": 7561,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "肯瑞托法师最钟爱的小伙伴之一。这个爬来爬去的小家伙最让人困惑的是——它究竟算是蛇呢，还是其他什么。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 74,
      "spellId": 10713
    },
    {
      "collectionId": 100342,
      "creatureEntry": 7562,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "这些棕色蟒蛇原产于部落控制的地区。它看上去并不显眼，直到猎物走进其攻击范围。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 77,
      "spellId": 10716
    },
    {
      "collectionId": 100344,
      "creatureEntry": 7565,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "克萨迪斯大胆地追踪、捕获并驯服那些大蟒蛇，以便它们能在战斗中呼朋唤友。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 75,
      "spellId": 10714
    },
    {
      "collectionId": 100346,
      "creatureEntry": 7567,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "这条赤练蛇深受暗矛巨魔的喜爱，不仅是因为它超强的毒性，还因为它不变的忠诚。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 78,
      "spellId": 10717
    },
    {
      "collectionId": 100350,
      "creatureEntry": 8376,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "别担心，我想这个单位的战斗机制和归返逻辑都已被禁用了。——奥格索普·奥布诺提斯",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 83,
      "spellId": 12243
    },
    {
      "collectionId": 100351,
      "creatureEntry": 9656,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "也许易爆，绝对可爱。远离明火。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 85,
      "spellId": 15048
    },
    {
      "collectionId": 100352,
      "creatureEntry": 9657,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "这个微小的维和安全机器人通常装备有最新式的施法者克星和群体打击者。不适用于环保人士。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 86,
      "spellId": 15049
    },
    {
      "collectionId": 100353,
      "creatureEntry": 9662,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "这些可爱的小家伙在经过一天的野蛮、血腥的战斗后，最喜欢和它们的主人依偎在一起。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 87,
      "spellId": 15067
    },
    {
      "collectionId": 100281,
      "creatureEntry": 10259,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "座狼是兽人们喜爱的伙伴，并在战场上极其忠诚。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 89,
      "spellId": 15999
    },
    {
      "collectionId": 100282,
      "creatureEntry": 10598,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "虽然出生在温暖的黑石塔高层，但烟网小蜘蛛能够适应绝大部分环境。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 90,
      "spellId": 16450
    },
    {
      "collectionId": 100298,
      "creatureEntry": 11325,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "这只迷你熊猫幼崽尽管天生嗜睡，却广受艾泽拉斯冒险者的追捧。",
