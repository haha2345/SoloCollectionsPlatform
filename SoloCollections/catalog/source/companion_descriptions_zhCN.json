      "sourceRowId": 92,
      "spellId": 17707
    },
    {
      "collectionId": 100356,
      "creatureEntry": 11326,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "天穹将要震颤，凡人注定悲泣，而末日将会——等等，你怎么这么高？",
