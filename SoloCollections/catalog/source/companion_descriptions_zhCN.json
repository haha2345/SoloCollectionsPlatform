      "sourceRowId": 93,
      "spellId": 17708
    },
    {
      "collectionId": 100297,
      "creatureEntry": 11327,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "异虫大军的成员，体型微小却凶猛善战，千万不要低估了跳虫的实力。如果成批来袭，是非常危险的。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 94,
      "spellId": 17709
    },
    {
