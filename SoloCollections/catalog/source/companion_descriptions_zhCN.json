      "collectionId": 100382,
      "creatureEntry": 16069,
      "descriptionStatus": "OFFICIAL_ZHCN_BATTLE_PET_SPECIES",
      "descriptionZhCN": "咕唧生来就是个表演者，尽管她很少抛头露面，只在极为难得的场合才会公开亮相。",
      "sourceBuild": "7.3.5.26972",
      "sourceRowId": 121,
      "spellId": 27241
    },
    {
